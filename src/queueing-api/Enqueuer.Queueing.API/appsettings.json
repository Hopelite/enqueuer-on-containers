{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "EventBus": "{CONNECTION_STRING}"
  },
  "EventBus": {
    "SubscriptionClientName": "Queueing_API"
  },
  "EventsDatabase": {
    "ConnectionString": "{CONNECTION_STRING}",
    "DatabaseName": "QueueingEventsDB",
    "EventsCollectionName": "Events"
  },
  "IdentityProvider":
  {
    "BaseAddress": "{IDENTITY_PROVIDER_URL}",
    "ClientId": "{CLIENT_ID}",
    "ClientSecret": "{CLIENT_SECRET}"
  },
  "OAuth":
  {
    "Issuer": "{OAUTH_ISSUER}",
    "SigningKey": "{SIGNING_KEY}"
  }
}
